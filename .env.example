# Copy to .env and fill in. Do not commit .env.

DBURL=
BETTER_AUTH_SECRET=
# Local dev only. On Vercel, leave unset (uses VERCEL_URL) or set to
# https://portal.sfusurge.com for production. Do not set to localhost on Vercel.
BETTER_AUTH_URL=http://localhost:3000

# Legacy env names still supported as fallbacks:
# NEXTAUTH_SECRET=
# NEXTAUTH_URL=

AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
AUTH_FIGMA_ID=
AUTH_FIGMA_SECRET=
AUTH_MAIL_SERVER=

SENDINGEMAIL=
EMAILPASS=
SMTP_MAX_MESSAGES_PER_CONNECTION=100
EMAIL_HOURLY_QUOTA=100
EMAIL_MAX_RETRIES=3
CRON_SECRET=

NEXT_PUBLIC_BLOB_URL=
# Login art (no DB). Prefer stable blob paths you overwrite to swap:
# https://….public.blob.vercel-storage.com/hackathons/login-banner.webp
# https://….public.blob.vercel-storage.com/hackathons/login-icon.webp
NEXT_PUBLIC_LOGIN_BANNER_URL=
NEXT_PUBLIC_LOGIN_ICON_URL=
BLOB_READ_WRITE_TOKEN=
CLIENT_URL=

ABLY_API_KEY=
NEXT_PUBLIC_ABLY_API_KEY=

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

DISCORD_INGEST_SECRET=
DISCORD_ATTACHMENT_REHOST_ENABLED=false

R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_DOMAIN=
